# Environment Variables

## Required
APP_DATABASE_URL=postgresql://user:password@host:5432/dbname_production
APP_DATABASE_DEVELOPMENT=postgresql://user:password@host:5432/dbname_dev
SESSION_SECRET=change-me-to-a-random-64-char-string

## Optional (feature degrades gracefully when unset)
# OPENROUTER_API_KEY=
# AGENTMAIL_API_KEY=

---
DATABASE_URL=postgresql://user:pass@ep-xxx.region.neon.tech/neondb?sslmode=require

# Anthropic API for AI paperwork scanning (set as secret in Replit)
# This is used server-side only — never expose to the browser
ANTHROPIC_API_KEY=sk-ant-xxx

# Speech-to-text for call-audio notes. Two modes:
#   1. LOCAL (default, keyless & private): whisper.cpp via nodejs-whisper.
#      Needs cmake/gcc/make/ffmpeg in the environment (see replit.nix).
#      Model downloaded on first use into WHISPER_MODEL_ROOT.
#   WHISPER_MODEL=base.en
#   WHISPER_MODEL_ROOT=/home/runner/whisper/models
#   2. HOSTED OpenAI-compatible endpoint (Groq/OpenAI/etc). Uncomment to use:
#   STT_BASE_URL=https://api.groq.com/openai
#   STT_API_KEY=your-key

# Optional: port for the API server (defaults to 3000)
# API_PORT=3000

# Node environment
# NODE_ENV=production
